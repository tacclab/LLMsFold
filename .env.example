# API key for Groq chat/completions used during molecule generation.
GROQ_API_KEY=your-groq-api-key-here

# API key for NVIDIA services used by Boltz/docking-related steps.
NVIDIA_API_KEY=your-nvidia-api-key-here

# Path to the target protein structure in PDB format.
PDB_FILE=data/acvr1_R206H_clean.pdb

# Path to the few-shot examples CSV used to guide generation.
FEW_SHOT_CSV=data/few_shot_smiles_patent.csv

# Output directory for generated molecules, logs, and reports.
OUTPUT_DIR=results

# Number of optimization iterations to run.
MAX_ITERATIONS=3

# Number of candidate molecules sampled per iteration.
MAX_SAMPLES=2

# Groq model used for SMILES generation.
LLM_MODEL=llama-3.3-70b-versatile

# Sampling temperature for the Groq model (0.0-2.0).
LLM_TEMPERATURE=0.8

# Optional logging verbosity (e.g., DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Seconds the NVIDIA NVCF gateway holds the initial connection open before
# returning a 202 + task_id (keep low so failures surface quickly).
BOLTZ_POLL_HEADER_SECONDS=60

# Affinity probability required before affinity contributes to the ranking score.
ADJ_AFFINITY_THRESHOLD=0.6

# Maximum synthetic accessibility score allowed in the final report (1.0-10.0).
SAS_SCORE_MAX=6.0

# Tanimoto similarity at which a candidate starts losing reward for resembling
# something already registered. The penalty ramps linearly from zero here to
# SIMILARITY_PENALTY_FRACTION of the binding probability at similarity 1.0.
# Lower this to push the run toward more distinct chemistry.
SIMILARITY_PENALTY_THRESHOLD=0.6

# Largest share of the binding probability the similarity term can remove,
# reached only at similarity 1.0 (0.0 disables the penalty entirely).
SIMILARITY_PENALTY_FRACTION=0.5

# A generated molecule is fed back as a new prompt lead only if its Tanimoto
# similarity to every lead already in the pool is below this value. Lower it to
# keep the feedback loop from collapsing onto a single scaffold family.
LEAD_DIVERSITY_MAX_SIM=0.7

# Minimum Boltz2_Binding_Probability (affinity_probability_binary from Boltz2)
# required to persist a docked structure to disk. Observed values vary by target
# and run; inspect your own unified_report.csv distribution before picking this
# threshold rather than assuming a fixed typical range.
BEST_STRUCTURE_AFFINITY_THRESHOLD=0.03

# Minimum Boltz ipTM required to keep a candidate (0.0-1.0).
IPTM_THRESHOLD=0.95

# Minimum Boltz pLDDT required to keep a candidate (0.0-1.0).
PLDDT_THRESHOLD=0.9

# Optional seed applied to Python/NumPy RNG and passed to the Groq chat
# completion call for more reproducible runs. Leave unset for unseeded runs.
RANDOM_SEED=

# --- Independent (holdout) evaluation ---------------------------------------
# Holdout evaluators judge finished candidates using methods that took no part
# in selecting them. Set to false to skip them entirely (the run then rests on
# the in-loop predictor alone, which the manifest records).
ENABLE_HOLDOUT_EVALUATION=true

# Prepared receptor PDBQT for AutoDock Vina rescoring. Left unset by default:
# preparing a receptor involves protonation and cofactor choices that belong to
# whoever set up the target, so this pipeline will not guess them. Without it,
# Vina reports itself unavailable and PoseBusters still runs.
# VINA_RECEPTOR_PDBQT=data/acvr1_receptor.pdbqt

# --- Binding pocket selection ------------------------------------------------
# By default the pocket is found by geometry. Set at most ONE of the following
# to pin it instead; the manifest records which source was used.
#
# Residues you name: 'A:203,A:207', bare numbers '203,207', or 'ALA203_A'.
# POCKET_RESIDUES=A:206,A:207,A:210
#
# Residues around a ligand bound in the input structure, by residue name.
# Narrow to one copy with NAME:chain or NAME:chain:number.
# POCKET_LIGAND=ATP
#
# Residues around a point in the structure's own coordinate frame.
# POCKET_CENTER=32.4,-21.2,52.0
#
# A specific detected pocket, by 0-based index, instead of automatic selection.
# POCKET_INDEX=2
#
# Radius in Angstroms used by POCKET_LIGAND and POCKET_CENTER.
POCKET_CONTACT_DISTANCE=8.0

# --- Large-run settings -------------------------------------------------------
# Total molecules generated = MAX_ITERATIONS x MAX_SAMPLES.
# For a 1000-molecule run, e.g. MAX_ITERATIONS=100 and MAX_SAMPLES=10.
#
# How many previously proposed molecules are echoed back in the prompt so the
# model does not repeat them. The default of 10 is fine for a 3-iteration run
# but far too short for a long one: the model cannot see most of what it has
# already made and re-proposes it. Duplicates are cached rather than rescored,
# so the cost is wasted generation calls, not wasted evaluations. Raise this
# for long runs, but keep it well inside the model's context window.
ALREADY_PROPOSED_WINDOW=10

# PubChem asks callers to stay at or below five requests per second and blocks
# addresses that do not. Novelty checks fan out across every candidate at once,
# so these two limits are what keep a large run inside that budget. Raising
# them risks having your address blocked.
PUBCHEM_MAX_CONCURRENCY=4
PUBCHEM_MIN_REQUEST_INTERVAL_SECONDS=0.25
